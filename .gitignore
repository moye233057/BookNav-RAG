# 密钥与本地配置：.env 只有本机有，模板 .env_example 进仓
.env
.env.local
.env.*.local

# 本机私有评测集（第三方手册 grounding，不进仓）；公开默认用 eval_samples.json
scripts/eval_samples.private.json
*.private.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# 数据与权重一律不进仓：样例源文件、抽取产物、向量库、模型权重
# data/source/ 只留一份说明（README.txt），第三方版权文档不要提交
/data/*
!/data/source/
/data/source/*
!/data/source/README.txt
/models/

# 前端
/web/node_modules/
/web/dist/

# 编辑器与杂项
.vscode/
.idea/
.DS_Store
*.log
